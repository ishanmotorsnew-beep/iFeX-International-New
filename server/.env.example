# Server
PORT=10000
CLIENT_ORIGIN=https://ifex.kesug.com
NODE_ENV=development

# SMTP configuration — used by Nodemailer to send contact form submissions.
# For Gmail, use port 465 with SMTP_SECURE=true or port 587 with SMTP_SECURE=false.
# Gmail also requires an app password instead of your regular account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ifexinternational@gmail.com
SMTP_PASS=ftno bubn kbzs cykk

# Where contact form submissions should be delivered
CONTACT_RECEIVER_EMAIL=ifexinternational@gmail.com

# The "from" address used when sending. Some providers require this to
# match the authenticated SMTP_USER domain.
CONTACT_SENDER_EMAIL=ifexinternational@gmail.com

# Admin panel — the password used to log in at /admin/login.
# Change this to something strong before deploying anywhere public.
ADMIN_PASSWORD=5HM88fq2q97@+
